{
  "$id": "https://github.com/grafana/grafana/blob/main/public/schemas/dashboard/v2.0.x/dashboard_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "gridPos": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "maximum": 24,
          "minimum": 1,
          "type": "integer"
        },
        "w": {
          "maximum": 24,
          "minimum": 1,
          "type": "integer"
        },
        "x": {
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "type": "object"
    },
    "panel": {
      "additionalProperties": true,
      "properties": {
        "datasource": {
          "description": "Panel-level default datasource.",
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Optional panel description.",
          "type": "string"
        },
        "fieldConfig": {
          "additionalProperties": true,
          "description": "Optional field config overrides.",
          "type": "object"
        },
        "gridPos": {
          "$ref": "#/definitions/gridPos"
        },
        "id": {
          "description": "Unique panel id within the dashboard.",
          "minimum": 1,
          "type": "integer"
        },
        "maxDataPoints": {
          "type": "integer"
        },
        "options": {
          "additionalProperties": true,
          "description": "Optional panel-type-specific options.",
          "type": "object"
        },
        "targets": {
          "description": "Query targets for the panel.",
          "items": {
            "$ref": "#/definitions/target"
          },
          "type": "array"
        },
        "title": {
          "description": "Panel title shown above the panel.",
          "minLength": 1,
          "type": "string"
        },
        "transparent": {
          "type": "boolean"
        },
        "type": {
          "description": "Grafana panel plugin type (e.g. 'timeseries', 'stat', 'table').",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "gridPos"
      ],
      "type": "object"
    },
    "target": {
      "additionalProperties": true,
      "properties": {
        "datasource": {
          "description": "Optional per-target datasource override.",
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "exemplar": {
          "type": "boolean"
        },
        "expr": {
          "description": "PromQL expression. Must reference a known metric from the per-metric instrumentation matrix (validated separately by test_each_panel_metric_in_per_metric_matrix).",
          "minLength": 1,
          "type": "string"
        },
        "hide": {
          "type": "boolean"
        },
        "instant": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "legendFormat": {
          "description": "Optional legend format string.",
          "type": "string"
        },
        "range": {
          "type": "boolean"
        },
        "refId": {
          "description": "Target reference id (e.g. 'A', 'B').",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "expr",
        "refId"
      ],
      "type": "object"
    }
  },
  "description": "Minimal JSON Schema subset for validating FastBlocks overview dashboards against Grafana 10.x shape. Vendored per v6 spec to lock the panel structure independent of upstream schema churn (Open Review Flag #4). Covers only the fields actually used by fastblocks-overview.json: dashboard.title / uid / panels / timezone / schemaVersion / refresh, plus panels[].{id, title, type, datasource, targets, gridPos, fieldConfig, options} and targets[].{expr, refId, datasource, legendFormat}.",
  "properties": {
    "annotations": {
      "additionalProperties": true,
      "description": "Optional annotations list.",
      "type": "object"
    },
    "description": {
      "description": "Optional dashboard description.",
      "type": "string"
    },
    "panels": {
      "description": "Top-level dashboard panels.",
      "items": {
        "$ref": "#/definitions/panel"
      },
      "type": "array"
    },
    "refresh": {
      "description": "Auto-refresh interval (e.g. '30s', '1m').",
      "type": "string"
    },
    "schemaVersion": {
      "description": "Grafana dashboard schema version. Grafana 10.x is schemaVersion 39.",
      "minimum": 30,
      "type": "integer"
    },
    "tags": {
      "description": "Optional dashboard tags.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "templating": {
      "additionalProperties": true,
      "description": "Optional template variables.",
      "type": "object"
    },
    "time": {
      "additionalProperties": true,
      "description": "Default time range (Grafana-native shape).",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "timezone": {
      "description": "Dashboard timezone (e.g. 'browser', 'utc').",
      "type": "string"
    },
    "title": {
      "description": "Dashboard title shown in the Grafana UI header.",
      "minLength": 1,
      "type": "string"
    },
    "uid": {
      "description": "Stable dashboard identifier. Grafana uses this for /d/<uid> URLs.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "title",
    "uid",
    "panels"
  ],
  "title": "FastBlocks Grafana 10.x Dashboard Schema (vendored subset)",
  "type": "object"
}
