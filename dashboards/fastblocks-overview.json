    {
      "id": 5,
      "title": "/metrics Endpoint — Dispatch + Errors (table)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Two targets on one panel: (A) /metrics endpoint dispatch count normalised by Accept header class (openmetrics / text / wildcard / missing / other, per Δ53 cardinality-bounded 5-value Literal). (B) /metrics endpoint error count by exception class. Sources: Task 9 fastblocks_metrics_endpoint_dispatch_total + fastblocks_metrics_endpoint_errors_total.",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (accept_header) (rate(fastblocks_metrics_endpoint_dispatch_total[5m]))",
          "refId": "A",
          "legendFormat": "dispatch {{accept_header}}",
          "format": "table",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "sum by (reason) (rate(fastblocks_metrics_endpoint_errors_total[5m]))",
          "refId": "B",
          "legendFormat": "errors {{reason}}",
          "format": "table",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
