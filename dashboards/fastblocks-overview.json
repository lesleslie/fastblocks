  "description": "FastBlocks observability overview dashboard. Ties together the per-metric instrumentation matrix from v6 spec §Decision 36 (Phase 6 runbook). Eight panels, each referencing a metric defined by Phases 6A (counters/OTel) and 6B (cardinality guards) and 6C (bridges: MCP, Sentry, a11y). Datasource: Prometheus. Schema: Grafana 10.x (schemaVersion 39).",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "MCP Tool Invocations / sec",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-tool MCP invocation rate. Labels: tool_name (P1-5 enumerated), tool_status (ok/error/validation_error per Δ30). Source: Task 8 fastblocks_mcp_tool_invocations_total Counter.",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "invocations/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(fastblocks_mcp_tool_invocations_total[5m]))",
          "refId": "A",
          "legendFormat": "{{tool_name}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 2,
      "title": "MCP Tool Duration p95 (seconds)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "p95 wall-clock duration of MCP tool invocations, per tool_name. Histogram source: Task 8 fastblocks_mcp_tool_duration_seconds. The dashboard queries the auto-generated _bucket suffix (Prometheus convention); the validator normalises this back to the base metric name.",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "seconds",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tool_name, le) (rate(fastblocks_mcp_tool_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p95 {{tool_name}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
