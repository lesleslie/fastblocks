    {
      "id": 7,
      "title": "Sentry Bridge Disabled / sec",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Cumulative count of times the Sentry bridge was disabled. reason ∈ Literal[\"import_error\", \"init_runtime_error\"] (Δ39-ζ). Brief mentioned Δ57 rename to fastblocks_sentry_init_failures_total; current Task 12 code uses fastblocks_sentry_disabled_total — the canonical name in code is the metric exported today. Runbook threshold: any rate > 0 → verify Sentry SDK alpha pin (sentry-sdk[opentelemetry]>=3.0.0a7,<3.0.0a8 per Δ55) and sentry_sdk.opentelemetry import path. Source: Task 12 fastblocks_sentry_disabled_total Counter.",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(fastblocks_sentry_disabled_total[1h]))",
          "refId": "A",
          "legendFormat": "{{reason}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
